# ==============================================
# SUPABASE CONFIGURATION
# ==============================================

# Supabase Public URL - visible to browser (safe)
NEXT_PUBLIC_SUPABASE_URL="https://akbsaljjwspbjgjrgkur.supabase.co"

# Supabase Anonymous Key - visible to browser (safe)
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_EcAIBjcZ2IAT0Le8aYUPXA_6MyxR0iM"

# ⚠️ SUPABASE SERVICE ROLE KEY - SERVER ONLY (NEVER expose to client!)
# Get from: Supabase Dashboard > Settings > API > service_role (Secret key)
# This key is used by /app/api/transactions/ routes to bypass RLS policies
# REQUIRED to fix: "new row violates row-level security policy"
# Keep this PRIVATE and only in .env.local (never commit to git)
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"

# ==============================================
# GOOGLE GEMINI API CONFIGURATION  
# ==============================================

# Required for Gemini AI API calls (transaction parsing)
# Get from: https://aistudio.google.com/app/apikeys
GEMINI_API_KEY="your_gemini_api_key_here"
NEXT_PUBLIC_GEMINI_API_KEY="legacy_public_key_not_required_for_cloud_run"

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
